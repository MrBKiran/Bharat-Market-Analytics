# Copy this file to `.env` and edit. NEVER commit `.env`.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- MongoDB (local Community Edition, no authentication) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=BharatMarketDB
MONGO_TIMEOUT_MS=5000

# --- API ---
# Comma-separated list of allowed browser origins (React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Key required in the X-API-Key header by endpoints that change data. Leave empty in development (open on localhost);
# in production, an empty key DISABLES those endpoints. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
HEAVY_RATE_LIMIT_PER_MINUTE=20

# --- Files ---
MAX_UPLOAD_MB=200

# --- Spark (Phase 8) ---
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.21.10002-hotspot

# --- Kaggle (Phase 4): get a token at kaggle.com > Settings > API ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Optional broker API (leave empty if unused) ---
# BROKER_API_KEY=
# BROKER_API_SECRET=
